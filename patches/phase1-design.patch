+// ── Spotlight цикъл между картите на шофьорите: фокус/избледняване по ред.
+//    Спира завинаги (за сесията) при първо докосване на списъка — не се
+//    съживява при последващ render(), защото spotlightStopped е глобален. ──
+var spotlightTimer=null, spotlightIdx=0, spotlightStopped=false, spotlightClickBound=false;
+function initSpotlight(){
+  if(spotlightTimer){clearInterval(spotlightTimer);spotlightTimer=null;}
+  if(spotlightStopped)return;
+  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){spotlightStopped=true;return;}
+  var dl=document.getElementById('dlist');
+  if(!dl)return;
+  var cards=dl.querySelectorAll('.dc');
+  if(cards.length<2)return; // няма смисъл от цикъл с 0-1 карта
+  spotlightIdx=0;
+  applySpotlight(cards);
+  spotlightTimer=setInterval(function(){
+    var live=document.getElementById('dlist');
+    if(!live){clearInterval(spotlightTimer);return;}
+    var c=live.querySelectorAll('.dc');
+    if(c.length<2)return;
+    spotlightIdx=(spotlightIdx+1)%c.length;
+    applySpotlight(c);
+  },3400);
+  if(!spotlightClickBound){
+    spotlightClickBound=true;
+    dl.addEventListener('click',function(){
+      spotlightStopped=true;
+      if(spotlightTimer){clearInterval(spotlightTimer);spotlightTimer=null;}
+      document.querySelectorAll('.dc').forEach(function(c){c.classList.remove('ft-spotlight');c.classList.remove('ft-dim');});
+    },{once:true});
+  }
+}
+function applySpotlight(cards){
+  cards.forEach(function(c,i){
+    c.classList.toggle('ft-spotlight',i===spotlightIdx);
+    c.classList.toggle('ft-dim',i!==spotlightIdx);
+  });
 }
 
