+}
+function renderGalleryImg(){
+  if(!galleryPhotos.length)return;
+  var img=document.getElementById('imglb-img');
+  img.style.opacity=0;
+  setTimeout(function(){ img.src=galleryPhotos[galleryIdx]; img.style.opacity=1; },90);
+  var cnt=document.getElementById('imglb-count');
+  var multi=galleryPhotos.length>1;
+  cnt.style.display=multi?'block':'none';
+  if(multi)cnt.textContent=(galleryIdx+1)+' / '+galleryPhotos.length;
+  document.querySelectorAll('.imglb-nav').forEach(function(b){b.style.display=multi?'flex':'none';});
+}
+function galleryStep(dir){
+  if(!galleryPhotos.length)return;
+  galleryAutoStopped=true;
+  if(galleryTimer){clearInterval(galleryTimer);galleryTimer=null;}
+  galleryIdx=(galleryIdx+dir+galleryPhotos.length)%galleryPhotos.length;
+  renderGalleryImg();
+}
+function startGalleryAuto(){
+  galleryAutoStopped=false;
+  if(galleryTimer){clearInterval(galleryTimer);galleryTimer=null;}
+  if(galleryPhotos.length<2)return;
+  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
+  // Тихо превъртане на снимките — спира завинаги при първо докосване/суайп/стрелка
+  galleryTimer=setInterval(function(){
+    if(galleryAutoStopped)return;
+    galleryIdx=(galleryIdx+1)%galleryPhotos.length;
+    renderGalleryImg();
+  },3200);
+}
+function bindGallerySwipe(){
+  if(gallerySwipeBound)return;
+  gallerySwipeBound=true;
+  var el=document.getElementById('imglb');
+  el.addEventListener('touchstart',function(e){galleryTouchX=e.touches[0].clientX;},{passive:true});
+  el.addEventListener('touchend',function(e){
+    if(galleryTouchX===null)return;
+    var dx=e.changedTouches[0].clientX-galleryTouchX;
+    galleryTouchX=null;
+    if(Math.abs(dx)>40)galleryStep(dx<0?1:-1);
+  },{passive:true});
+}
+function hideImg(){
